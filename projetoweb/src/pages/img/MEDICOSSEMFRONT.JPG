  transform: rotate(-90deg);
}

div[data-rewards-widget].medallion .medal-goal-track-meter circle {
  stroke: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion .goal-track-medal-type {
  width: 32px;
  height: 32px;
  fill: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion .goal-track-outer-circle {
  width: 32px;
  height: 32px;
  position: absolute;
  stroke: var(--rw-color, var(--rw-medal-color));
  opacity: 0.4;
}

/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */#rewid-af {
  position: absolute;
  z-index: 10;
  top: 50px;
  right: 0;
  font-size: 0;
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.1), 0 2px 4px 1px rgba(0, 0, 0, 0.18);
  border-radius: 5px;
}

#rewid-af:dir(rtl) {
  right: auto;
  left: 0;
}

#rewid-af iframe {
  border-radius: 5px;
}

/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */#rewid-f {
  position: fixed;
  right: 0;
  top: 0;
  width: 376px;
  height: 100vh;
  z-index: 1100;
  box-shadow: 0 0 0 1px #0000000d, 0 0 0 2px #0000001a;
}

.b_pinhead #b_header #id_h #id_rh_w #rewid-f {
  visibility: visible;
}

#rewid-f.modern {
  position: absolute;
  z-index: 10;
  top: 50px;
  right: 0;
  font-size: 0;
  width: 0vh;
  height: 0vh;
  visibility: none;
}

#rewid-f.modern iframe {
  border-radius: 5px;
}

#rewid-f:dir(rtl) {
  right: auto;
  left: 0;
}

/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */div[data-rewards-widget].medallion.rw-dark {
  --rw-medal-color: #a2b7f4;
  --rw-medal-color-glow: #4a9eff;
  --rw-font-color: #edebe9;
  --rw-red-dot-color: #ff4c4c;
}

div[data-rewards-widget].medallion {
  --rw-medal-color: #174ae4;
  --rw-medal-color-glow: #1e90ff;
  --rw-font-color: #333333;
  --rw-red-dot-color: #c80000;
  --rw-red-dot-diameter: 7px;
  display: inline-block;
  cursor: pointer;
  position: relative;
}

div[data-rewards-widget].medallion:not(.copilotSearch) > div {
  display: flex;
  align-items: center;
  text-decoration: none;
  height: 100%;
  padding: 0 4px;
}

div[data-rewards-widget].medallion:not(.copilotSearch) > div > * {
  padding: 0 4px;
  display: flex;
}

div[data-rewards-widget].medallion:not(.copilotSearch) .points-container {
  color: var(--rw-color, var(--rw-font-color));
  font-family: var(--rw-font-family);
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
  display: inline-block;
  text-align: right;
}

div[data-rewards-widget].medallion:not(.copilotSearch) div.medal {
  position: relative;
}

@keyframes rw-medal-ripple {
  0% {
    box-shadow: 0 0 0 0 rgba(78, 131, 246, 0), 0 0 0 2px rgba(78, 131, 246, 1);
    opacity: 1;
  }

  20% {
    box-shadow: 0 0 0 2px rgba(78, 131, 246, 0.5), 0 0 0 2px rgba(78, 131, 246, 0.8);
    opacity: 1;
  }

  50% {
    box-shadow: 0 0 0 6px rgba(78, 131, 246, 0.3), 0 0 0 2px rgba(78, 131, 246, 0.5);
    opacity: 0.8;
  }

  80% {
    box-shadow: 0 0 0 8px rgba(78, 131, 246, 0.15), 0 0 0 2px rgba(78, 131, 246, 0.2);
    opacity: 0.3;
  }

  100% {
    box-shadow: 0 0 0 12px rgba(78, 131, 246, 0), 0 0 0 2px rgba(78, 131, 246, 0);
    opacity: 0;
  }
}

div[data-rewards-widget].medallion.glow-medal:not(.copilotSearch):not(.frozen):not(.ocean-commotion) div.medal::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 29px;
  height: 29px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  opacity: 0;
  animation: rw-medal-ripple 1s ease-out 3;
  pointer-events: none;
}

div[data-rewards-widget].medallion:not(.copilotSearch) svg.medal-circled {
  width: 32px;
  height: 32px;
  fill: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion svg.medal-new-level {
  width: 20px;
  height: 20px;
}

div[data-rewards-widget].medallion svg.medal-newlevel-circled {
  width: 32px;
  height: 32px;
}

div[data-rewards-widget].medallion svg.medal-circled circle {
  stroke: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion .light-ring svg.medal-circled circle {
  opacity: 0.3;
}

div[data-rewards-widget].medallion svg.medal-light {
  width: 32px;
  height: 32px;
  fill: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion .red-dot {
  width: var(--rw-red-dot-diameter);
  height: var(--rw-red-dot-diameter);
  border-radius: 50%;
  background-color: var(--rw-red-dot-color);
  top: -3px;
  right: 1px;
  position: absolute;
}

div[data-rewards-widget].medallion .red-dot.adjacent {
  right: 0;
  top: 0;
}

/* Copilot Search styles*/
div[data-rewards-widget].medallion.copilotSearch .points-container {
  color: var(--acf-color-fore-neutral-quaternary, rgba(0, 0, 0, 0.6));
  text-align: center;
  font-size: 13px;
  font-style: normal;
  font-weight: 400;
  line-height: 20px;
}

div[data-rewards-widget].medallion.copilotSearch .b_clickarea:hover .points-container {
  color: var(--acf-color-fore-neutral-secondary, rgba(0, 0, 0, 0.8));
}

div[data-rewards-widget].medallion.copilotSearch.rw-dark .points-container {
  color: var(--acf-color-fore-neutral-quaternary, rgba(255, 255, 255, 0.6));
}

div[data-rewards-widget].medallion.copilotSearch.rw-dark .b_clickarea:hover .points-container {
  color: var(--acf-color-fore-neutral-secondary, rgba(255, 255, 255, 0.8));
}

div[data-rewards-widget].medallion.copilotSearch div.medal {
  display: flex;
  align-items: center;
  justify-content: inherit;
}

div[data-rewards-widget].medallion.copilotSearch svg.medal-circled {
  fill: black;
  height: 17px;
  fill-opacity: 0.6;
}

div[data-rewards-widget].medallion.copilotSearch .b_clickarea:hover svg.medal-circled {
  fill: #202020;
  fill-opacity: unset;
}

div[data-rewards-widget].medallion.copilotSearch.rw-dark svg.medal-circled {
  fill: white;
}

div[data-rewards-widget].medallion.copilotSearch.rw-dark .b_clickarea:hover svg.medal-circled {
  fill: #cfdeff;
}

/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */</style></head><body class="b_respl b_rdy b_sbText"><div id="OverlayMask" data-bm="313"></div><div id="bnp.nid.63245" class=" " data-viewname="BottomBanner_NoTitleRejectBtn" data-vertical="nonserp" data-bm="240" style="display: block;"><div id="bnp_cookie_banner" class="bnp_cookie_banner StackedView" role="dialog" aria-modal="false" data-position="" data-overlay="false"><div id="bnp_container" class="bnp_container"><div class="bnp_title_container"><div class="b_logo bnp_icon" data-bm="1"></div><p class="bnp_title"></p></div><div class="bnp_content"><div class="bnp_content_desc"><div class="bnp_desc_left">A Microsoft e nossos fornecedores terceirizados usam cookies e tecnologias semelhantes para fornecer, manter e melhorar nossos serviços e anúncios. Se você concordar, usaremos esses dados para personalização de anúncios e análises associadas.</div><div class="bnp_desc_right">Você pode selecionar 'Aceitar' para consentir com esses usos, 'Rejeitar' para recusar esses usos ou clicar em 'Mais opções' para revisar suas opções. Você pode alterar sua seleção em 'Gerenciar Preferências de cookies' na parte inferior desta página. &nbsp;<a href="https://go.microsoft.com/fwlink/?LinkId=521839" target="_blank" id="bnp_desc_left_privacy" class="bnp_desc_left_privacy">Política de Privacidade</a></div></div><div class="bnp_action_container"><div id="bnp_btn_accept" class="bnp_btn_accept"><a href="javascript: void(0)" h="ID=images.1,5007.1">Aceitar</a></div><div id="bnp_btn_reject" class="bnp_btn_reject"><a href="javascript: void(0)" h="ID=images.1,5008.1">Rejeitar</a></div><a class="bnp_btn_preference" id="bnp_btn_preference" href="javascript: void(0)" h="ID=images.1,5009.1"><span class="bnp_btn_preference_text">Mais opções</span></a></div></div></div></div><div id="cookie_preference" class="cookie_preference"><div id="mcp_container" class="mcp_container" style="display: none;"><div id="mcp_overlay" class="mcp_overlay"><div class="closeicon_overlay"><div id="closeicon" class="closeicon"><img class="rms_img" src="data:image/png;base64," data-bm="16" data-thhnrepbd="1"></div></div></div><div class="mcp_content"><div class="cookie_prefer_container"><div class="mcp_head">Gerenciar preferências de cookies</div><div class="mcp_head_desc">Também usamos cookies essenciais, que não podem ser desativados</div><div class="b_vPanel"><div><div class="mcp_row mcp_row_analytics"><div class="mcp_row_head">Analítica:</div><div class="mcp_analytics_desc"><div class="mcp_row_desctext">Podemos permitir que terceiros usem cookies de análise para entender como você utiliza nossos sites, para que nós possamos torná-los melhores e para que esses terceiros possam desenvolver e aprimorar seus produtos, que podem ser usados em sites que não são de propriedade ou operados pela Microsoft.</div><div class="mcp_head_desc_slider"><label class="switch"><input type="checkbox" id="analytics_checkbox" aria-label="Analítica:"><span class="slider round"></span></label></div><div class="mcp_head_desc_slidertext analytics_checkbox">Desativado</div></div></div></div><div><div class="mcp_row mcp_row_socialmedia"><div class="mcp_row_head">Mídia social:</div><div class="mcp_social_desc"><div class="mcp_row_desctext">Podemos usar cookies de mídia social para mostrar conteúdo com base em seus perfis de mídia social e atividade em nossos sites. Eles são usados para conectar sua atividade em nossos sites aos seus perfis de mídia social, para que o conteúdo que você vê em nossos sites e nas mídias sociais reflita melhor seus interesses.</div><div class="mcp_head_desc_slider"><label class="switch"><input type="checkbox" id="sm_checkbox" aria-label="Mídia social:"><span class="slider round"></span></label></div><div class="mcp_head_desc_slidertext sm_checkbox">Desativado</div></div></div></div><div><div class="mcp_row mcp_row_ad"><div class="mcp_row_head">Publicidade:</div><div class="mcp_ad_desc"><div class="mcp_row_desctext">Habilite o uso de cookies para tornar a publicidade mais relevante e para apoiar a obtenção de conteúdo de alta qualidade neste site. Se você não permitir esse uso, os anúncios exibidos para você podem ser menos relevantes.</div><div class="mcp_head_desc_slider"><label class="switch"><input type="checkbox" id="ad_checkbox" aria-label="Publicidade:"><span class="slider round"></span></label></div><div class="mcp_head_desc_slidertext ad_checkbox">Desativado</div></div></div></div><div><div class="mcp_buttons"><div class="mcp_savesettings"><span id="CF94FD_1_btn" class="cbtn" data-appns="images.1" data-k="5011.1"><a id="mcp_savesettings" aria-disabled="true" class="disabledbtn">Salvar Configurações</a></span></div></div></div></div></div></div></div></div></div><div id="ajaxStyles" data-bm="549"><div data-bm="562"></div><style type="text/css">#b_header #id_h{content-visibility:hidden}#b_results>.b_ans:not(.b_top):nth-child(n+5) .rqnaContainerwithfeedback #df_listaa{content-visibility:auto;contain-intrinsic-size:648px 205px}#b_results>.b_algo:not(.b_algoBorder):nth-child(n+5)>h2{content-visibility:auto;contain-intrinsic-size:608px 24px}#b_results>.b_algo:not(.b_algoBorder):nth-child(n+5) .b_caption:not(.b_rich):not(.b_capmedia):not(.b_snippetgobig):not(.rebateContent){content-visibility:auto;contain-intrinsic-size:608px 65px;padding-right:16px;margin-right:-16px;margin-left:-16px;padding-left:16px}#b_results>.b_algo:not(.b_algoBorder):nth-child(n+5) .b_caption.b_rich .captionMediaCard .wide_wideAlgo{content-visibility:auto;contain-intrinsic-size:370px 120px}#b_results>.b_algo:not(.b_algoBorder):nth-child(n+5) .scs_icn{content-visibility:auto}#b_results>.b_ans:nth-child(n+7) .b_rs:not(.pageRecoContainer){content-visibility:auto;contain-intrinsic-size:608px 296px}#b_results>.b_ans:nth-child(n+7) .b_rs:not(.pageRecoContainer) .b_rsv3{padding-bottom:1px}#b_results>.b_pag{content-visibility:auto;contain-intrinsic-size:628px 45px}#b_footer>#b_footerItems{content-visibility: